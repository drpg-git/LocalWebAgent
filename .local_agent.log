: \\\"Off\\\";\\n    }\\n  } catch {\\n    project.textContent = \\\"Unavailable\\\";\\n    logs.textContent = \\\"Unavailable\\\";\\n  }\\n}\\n\\nsave.addEventListener(\\\"click\\\", async () => {\\n  error.textContent = \\\"\\\";\\n  await chrome.storage.local.set({ token: token.value.trim(), mode: mode.value });\\n  const response = await chrome.runtime.sendMessage({ type: \\\"lwa_connect\\\" });\\n  if (!response?.ok) {\\n    error.textContent = response?.error || \\\"Connection failed\\\";\\n  }\\n  await refresh();\\n});\\n\\nrefresh();\\n\"\n  }"}, {"index": 10, "source": "raw-json", "length": 1017, "raw": "{\n    \"action\": \"create\",\n    \"path\": \"extension/styles.css\",\n    \"content\": \"body {\\n  margin: 0;\\n  min-width: 320px;\\n  font-family: Arial, sans-serif;\\n  background: #f5f5f5;\\n  color: #222;\\n}\\n\\n.popup {\\n  padding: 16px;\\n}\\n\\nh1 {\\n  margin: 0 0 16px;\\n  font-size: 18px;\\n}\\n\\nsection {\\n  margin-bottom: 16px;\\n  padding: 12px;\\n  background: white;\\n  border: 1px solid #ddd;\\n  border-radius: 8px;\\n}\\n\\n.row {\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 12px;\\n  padding: 6px 0;\\n  font-size: 13px;\\n}\\n\\n.row strong {\\n  max-width: 190px;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\nlabel {\\n  display: block;\\n  margin: 8px 0 5px;\\n  font-size: 12px;\\n}\\n\\ninput,\\nselect,\\nbutton {\\n  box-sizing: border-box;\\n  width: 100%;\\n  padding: 8px;\\n  border: 1px solid #ccc;\\n  border-radius: 6px;\\n  background: white;\\n}\\n\\nbutton {\\n  margin-top: 12px;\\n  cursor: pointer;\\n}\\n\\n.error {\\n  min-height: 16px;\\n  margin: 0;\\n  font-size: 12px;\\n}\\n\"\n  }"}]}}
