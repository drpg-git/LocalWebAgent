{"time": "2026-08-13T05:30:27.769+05:00", "level": "info", "event": "json_blocks_found", "data": {"messageHash": "dde491e5", "count": 7, "blocks": [{"index": 0, "source": "code-fence", "length": 30, "raw": "(?:json|JSON)?\\\\s*([\\\\s\\\\S]*?)"}, {"index": 1, "source": "raw-json-after-label", "length": 14419, "raw": "[\n  {\n    \"action\": \"create\",\n    \"path\": \"extension/background.js\",\n    \"content\": \"const DEFAULT_SETTINGS = {\\n  server: \\\"ws://127.0.0.1:8765/ws\\\",\\n  token: \\\"\\\",\\n  mode: \\\"manual\\\"\\n};\\n\\nlet socket = null;\\nlet connectingPromise = null;\\n\\nconst state = {\\n  connected: false,\\n  connecting: false,\\n  server: DEFAULT_SETTINGS.server,\\n  lastResult: null,\\n  pending: 0\\n};\\n\\nconst requests = new Map();\\n\\nasync function getSettings() {\\n  const settings = await chrome.storage.local.get(DEFAULT_SETTINGS);\\n  return {\\n    ...DEFAULT_SETTINGS,\\n    ...settings\\n  };\\n}\\n\\nasync function saveState() {\\n  await chrome.storage.local.set({ lwaState: state });\\n}\\n\\nasync function connect() {\\n  if (socket && socket.readyState === WebSocket.OPEN) {\\n    return socket;\\n  }\\n\\n  if (connectingPromise) {\\n    return connectingPromise;\\n  }\\n\\n  connectingPromise = new Promise(async (resolve, reject) => {\\n    const settings = await getSettings();\\n    state.server = settings.server || DEFAULT_SETTINGS.server;\\n    state.connecting = true;\\n    await saveState();\\n\\n    try {\\n      const url = new URL(state.server);\\n      if (settings.token) {\\n        url.searchParams.set(\\\"token\\\", settings.token);\\n      }\\n\\n      const ws = new WebSocket(url.toString());\\n      socket = ws;\\n\\n      ws.addEventListener(\\\"open\\\", async () => {\\n        state.connected = true;\\n        state.connecting = false;\\n        await saveState();\\n        broadcastState();\\n        resolve(ws);\\n      }, { once: true });\\n\\n      ws.addEventListener(\\\"message\\\", (event) => {\\