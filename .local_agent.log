{"time": "2026-08-13T02:36:04.354+05:00", "level": "info", "event": "apply_payload_received", "data": {"payload": {"files": [{"action": "create", "content": "body {\n  margin: 0;\n  min-width: 320px;\n  font-family: Arial, sans-serif;\n  background: #f5f5f5;\n  color: #222;\n}\n\n.popup {\n  padding: 16px;\n}\n\nh1 {\n  margin: 0 0 16px;\n  font-size: 18px;\n}\n\nsection {\n  margin-bottom: 16px;\n  padding: 12px;\n  background: white;\n  border: 1px solid #ddd;\n  border-radius: 8px;\n}\n\n.row {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 6px 0;\n  font-size: 13px;\n}\n\n.row strong {\n  max-width: 190px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\nlabel {\n  display: block;\n  margin: 8px 0 5px;\n  font-size: 12px;\n}\n\ninput,\nselect,\nbutton {\n  box-sizing: border-box;\n  width: 100%;\n  padding: 8px;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  background: white;\n}\n\nbutton {\n  margin-top: 12px;\n  cursor: pointer;\n}\n\n.error {\n  min-height: 16px;\n  margin: 0;\n  font-size: 12px;\n}\n", "path": "extension/styles.css"}]}, "files_count": 1}}
