{
  "manifest_version": 3,
  "name": "Local Web Agent",
  "version": "1.0.0",
  "description": "Bridge between ChatGPT and a local Local Web Agent server.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Local Web Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}